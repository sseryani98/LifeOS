# Node
node_modules/

# TypeScript build cache
*.tsbuildinfo

# Claude Code (keep .claude/commands/ and .claude/skills/ tracked)
.claude/settings.json
.claude/settings.local.json
.claude/*.md

# MCP server config (local dev convenience — Playwright browser choice is per-machine)
.mcp.json
.playwright-mcp/

# IDE — settings.json is tracked: it carries the folder view (hiding the workspace
# plumbing npm pins to the root), which every clone should get, not just this machine.
.vscode/*
!.vscode/settings.json

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Agent memory lives only at the repo root. A run started in any subfolder writes a stray copy there.
/*/**/.claude/agent-memory/

# Defect-sweep run logs (machine-local; the tracked record is .claude/defect-sweep/ledger.md)
.claude/defect-sweep/logs/

# Claude Code agent worktrees (machine-local)
.claude/worktrees/
