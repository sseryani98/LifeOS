<mvc:View
    controllerName="com.financialplanner.csvimportwizard.controller.CsvImportWizard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    displayBlock="true"
    core:require="{ formatter: 'com/financialplanner/csvimportwizard/model/formatter', sharedFormatter: 'com/financialplanner/shared/util/formatter', formatMessage: 'sap/base/strings/formatMessage' }"
>
    <f:DynamicPage
        id="idWizardDynamicPage"
        fitContent="true"
    >
        <f:title>
            <f:DynamicPageTitle id="idWizardDynamicPageTitle">
                <f:heading>
                    <Title
                        id="idImportTransactionsFromCSVTitle"
                        text="{i18n>pageTitle}"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <Wizard id="idImportWizard">
                <WizardStep
                    id="idUploadWizardStep"
                    title="{i18n>step1Title}"
                    icon="sap-icon://upload-to-cloud"
                    validated="{ui>/parsed}"
                >
                    <VBox
                        id="idDropZoneVBox"
                        class="sapUiMediumMargin sapUiContentPadding"
                        alignItems="Center"
                        justifyContent="Center"
                    >
                        <core:Icon
                            src="sap-icon://document"
                            size="2.5rem"
                            class="sapUiSmallMarginBottom"
                        />
                        <Text
                            id="idDragCSVFilesHereOrUseTheButtonBelowText"
                            text="{i18n>dropHint}"
                            textAlign="Center"
                        />
                        <u:FileUploader
                            id="idCsvFileUploader"
                            fileType="csv"
                            multiple="true"
                            buttonText="{i18n>chooseFiles}"
                            placeholder="{i18n>noFileChosen}"
                            change=".onFileUploaderChange"
                            class="sapUiSmallMarginTop"
                        />
                    </VBox>

                    <l:Grid
                        id="idUploadGrid"
                        defaultSpan="XL6 L6 M12 S12"
                        class="sapUiSmallMarginTop"
                    >
                        <VBox id="idSelectedFilesVBox">
                            <Label
                                id="idSelectedFilesLabel"
                                text="{i18n>selectedFiles}"
                            />
                            <Text
                                id="idFileNamesText"
                                text="{ui>/fileNames}"
                            />
                        </VBox>
                        <VBox id="idCardSelectVBox">
                            <Label
                                id="idCardSelectLabel"
                                text="{i18n>selectCard}"
                                required="true"
                            />
                            <ComboBox
                                id="idCardInstancesComboBox"
                                selectedKey="{ui>/selectedCard}"
                                placeholder="{i18n>selectCardPlaceholder}"
                                items="{
                                    path: '/CardInstances',
                                    parameters: { $expand: 'marketCard' },
                                    filters: [ { path: 'lifecycleState', operator: 'NE', value1: 'closed' } ]
                                }"
                            >
                                <core:ListItem
                                    key="{ID}"
                                    text="{marketCard/name}"
                                    additionalText="{cardholderName}"
                                />
                            </ComboBox>
                        </VBox>
                    </l:Grid>

                    <Button
                        id="idParseReviewButton"
                        text="{i18n>parseAndReview}"
                        type="Emphasized"
                        icon="sap-icon://begin"
                        enabled="{ui>/canParse}"
                        press=".onButtonParseFilesPress"
                        class="sapUiSmallMarginTop"
                    />
                </WizardStep>

                <WizardStep
                    id="idReviewWizardStep"
                    title="{i18n>step2Title}"
                    icon="sap-icon://inspection"
                >
                    <IconTabBar
                        id="idReviewIconTabBar"
                        expandable="false"
                        selectedKey="new"
                    >
                        <items>
                            <IconTabFilter
                                id="idNewIconTabFilter"
                                key="new"
                                text="{i18n>tabNew}"
                                count="{ui>/newCount}"
                            >
                                <OverflowToolbar id="idNewOverflowToolbar">
                                    <Text
                                        id="idProgressText"
                                        text="{ parts: [ 'i18n>progressCleared', 'ui>/clearedCount', 'ui>/newCount' ], formatter: 'formatMessage' }"
                                    />
                                    <ProgressIndicator
                                        id="idClearedProgressIndicator"
                                        percentValue="{ui>/progressPercent}"
                                        showValue="false"
                                        width="10rem"
                                        state="Success"
                                    />
                                    <ToolbarSpacer id="idNewToolbarSpacer" />
                                    <Text
                                        id="idRunningTotalText"
                                        text="{ parts: [ 'i18n>runningTotal', { path: 'ui>/totalAmount', formatter: 'sharedFormatter.formatAmount' } ], formatter: 'formatMessage' }"
                                    />
                                    <Button
                                        id="idApplyToSelectedButton"
                                        text="{i18n>applySelected}"
                                        icon="sap-icon://multiselect-all"
                                        press=".onButtonApplySelectedPress"
                                    />
                                    <Button
                                        id="idNewVendorButton"
                                        text="{i18n>newVendor}"
                                        icon="sap-icon://add"
                                        press=".onButtonNewVendorPress"
                                    />
                                    <Button
                                        id="idNewEarningCategoryButton"
                                        text="{i18n>newEarningCategory}"
                                        icon="sap-icon://add"
                                        press=".onButtonNewEarningCategoryPress"
                                    />
                                </OverflowToolbar>

                                <Table
                                    id="idNewRowsTable"
                                    mode="MultiSelect"
                                    items="{ui>/newRows}"
                                    growing="true"
                                    growingThreshold="50"
                                >
                                    <columns>
                                        <Column
                                            id="idNewDateColumn"
                                            width="8rem"
                                        >
                                            <Text
                                                id="idDateNewHeaderText"
                                                text="{i18n>colDate}"
                                            />
                                        </Column>
                                        <Column id="idNewDescColumn">
                                            <Text
                                                id="idDescriptionNewHeaderText"
                                                text="{i18n>colDescription}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewAmountColumn"
                                            width="7rem"
                                            hAlign="End"
                                        >
                                            <Text
                                                id="idAmountNewHeaderText"
                                                text="{i18n>colAmount}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewVendorColumn"
                                            width="11rem"
                                        >
                                            <Text
                                                id="idVendorNewHeaderText"
                                                text="{i18n>colVendor}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewTypeColumn"
                                            width="11rem"
                                        >
                                            <Text
                                                id="idPurchaseTypeNewHeaderText"
                                                text="{i18n>colPurchaseType}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewEarnColumn"
                                            width="11rem"
                                        >
                                            <Text
                                                id="idEarningCategoryNewHeaderText"
                                                text="{i18n>colEarningCategory}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewYieldColumn"
                                            width="7rem"
                                            hAlign="End"
                                        >
                                            <Text
                                                id="idEarningYieldNewHeaderText"
                                                text="{i18n>colEarningYield}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewCardColumn"
                                            width="11rem"
                                            visible="{ui>/hasSuppCards}"
                                        >
                                            <Text
                                                id="idCardNewHeaderText"
                                                text="{i18n>colCard}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewActionColumn"
                                            width="13rem"
                                        >
                                            <Text
                                                id="idActionsNewHeaderText"
                                                text="{i18n>colActions}"
                                            />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem
                                            id="idNewColumnListItem"
                                        >
                                            <cells>
                                                <Input
                                                    id="idPostedAtRowInput"
                                                    value="{ui>postedAt}"
                                                    editable="{= !${ui>cleared} }"
                                                />
                                                <Input
                                                    id="idRawDescriptionRowInput"
                                                    value="{ui>rawDescription}"
                                                    editable="{= !${ui>cleared} }"
                                                />
                                                <Input
                                                    id="idAmountRowInput"
                                                    value="{ui>amount}"
                                                    textAlign="End"
                                                    editable="{= !${ui>cleared} }"
                                                />
                                                <ComboBox
                                                    id="idVendorsRowComboBox"
                                                    selectedKey="{ui>vendor_ID}"
                                                    enabled="{= !${ui>cleared} }"
                                                    items="{ path: '/Vendors', templateShareable: false }"
                                                >
                                                    <core:Item
                                                        id="idNameRowVendorItem"
                                                        key="{ID}"
                                                        text="{name}"
                                                    />
                                                </ComboBox>
                                                <ComboBox
                                                    id="idPurchaseTypesRowComboBox"
                                                    selectedKey="{ui>purchaseType_ID}"
                                                    enabled="{= !${ui>cleared} }"
                                                    items="{ path: '/PurchaseTypes', templateShareable: false }"
                                                >
                                                    <core:Item
                                                        id="idNameRowTypeItem"
                                                        key="{ID}"
                                                        text="{name}"
                                                    />
                                                </ComboBox>
                                                <ComboBox
                                                    id="idEarningCategoriesRowComboBox"
                                                    selectedKey="{ui>earningCategory_ID}"
                                                    enabled="{= !${ui>cleared} }"
                                                    items="{ path: '/EarningCategories', templateShareable: false }"
                                                >
                                                    <core:Item
                                                        id="idNameRowEarnItem"
                                                        key="{ID}"
                                                        text="{name}"
                                                    />
                                                </ComboBox>
                                                <Text
                                                    id="idRowYieldText"
                                                    text="{i18n>yieldDeferred}"
                                                />
                                                <ComboBox
                                                    id="idCardInstancesRowComboBox"
                                                    selectedKey="{ui>cardInstance_ID}"
                                                    enabled="{= !${ui>cleared} }"
                                                    visible="{ui>/hasSuppCards}"
                                                    items="{ path: '/CardInstances', parameters: { $expand: 'marketCard' }, templateShareable: false }"
                                                >
                                                    <core:ListItem
                                                        id="idNameRowCardListItem"
                                                        key="{ID}"
                                                        text="{marketCard/name}"
                                                        additionalText="{cardholderName}"
                                                    />
                                                </ComboBox>
                                                <HBox id="idRowActionHBox">
                                                    <Button
                                                        id="idClearRowButton"
                                                        text="{i18n>clear}"
                                                        type="Transparent"
                                                        press=".onButtonClearRowPress"
                                                        visible="{= !${ui>cleared} }"
                                                    />
                                                    <Button
                                                        id="idRowClearMatchingButton"
                                                        icon="sap-icon://multi-select"
                                                        tooltip="{i18n>clearMatching}"
                                                        type="Transparent"
                                                        press=".onButtonClearMatchingPress"
                                                        visible="{= !${ui>cleared} }"
                                                    />
                                                    <Button
                                                        id="idUndoRowButton"
                                                        text="{i18n>undo}"
                                                        type="Transparent"
                                                        press=".onButtonUndoRowPress"
                                                        visible="{ui>cleared}"
                                                    />
                                                </HBox>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </IconTabFilter>

                            <IconTabFilter
                                id="idPotentialDuplicatesIconTabFilter"
                                key="duplicates"
                                text="{i18n>tabDuplicates}"
                                count="{ui>/duplicateCount}"
                            >
                                <Table
                                    id="idDuplicateRowsTable"
                                    items="{ui>/duplicateRows}"
                                >
                                    <columns>
                                        <Column id="idDupCsvDateColumn">
                                            <Text
                                                id="idCSVDateDupHeaderText"
                                                text="{i18n>colCsvDate}"
                                            />
                                        </Column>
                                        <Column id="idDupCsvDescColumn">
                                            <Text
                                                id="idCSVDescriptionDupHeaderText"
                                                text="{i18n>colCsvDescription}"
                                            />
                                        </Column>
                                        <Column
                                            id="idDupCsvAmountColumn"
                                            hAlign="End"
                                        >
                                            <Text
                                                id="idCSVAmountDupHeaderText"
                                                text="{i18n>colCsvAmount}"
                                            />
                                        </Column>
                                        <Column id="idDupExDateColumn">
                                            <Text
                                                id="idExistingDateDupHeaderText"
                                                text="{i18n>colExistingDate}"
                                            />
                                        </Column>
                                        <Column id="idDupExDescColumn">
                                            <Text
                                                id="idExistingDescriptionDupHeaderText"
                                                text="{i18n>colExistingDescription}"
                                            />
                                        </Column>
                                        <Column
                                            id="idDupExAmountColumn"
                                            hAlign="End"
                                        >
                                            <Text
                                                id="idExistingAmountDupHeaderText"
                                                text="{i18n>colExistingAmount}"
                                            />
                                        </Column>
                                        <Column
                                            id="idDupDecisionColumn"
                                            width="14rem"
                                        >
                                            <Text
                                                id="idDecisionDupHeaderText"
                                                text="{i18n>colDecision}"
                                            />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem
                                            id="idDupColumnListItem"
                                        >
                                            <cells>
                                                <Text
                                                    id="idPostedAtDupText"
                                                    text="{ui>csv/postedAt}"
                                                />
                                                <Text
                                                    id="idRawDescriptionDupText"
                                                    text="{ui>csv/rawDescription}"
                                                />
                                                <Text
                                                    id="idAmountDupText"
                                                    text="{ path: 'ui>csv/amount', formatter: 'sharedFormatter.formatAmount' }"
                                                />
                                                <Text
                                                    id="idExistingPostedAtDupText"
                                                    text="{ui>existingPostedAt}"
                                                />
                                                <Text
                                                    id="idExistingDescriptionDupText"
                                                    text="{ui>existingDescription}"
                                                />
                                                <Text
                                                    id="idExistingAmountDupText"
                                                    text="{ path: 'ui>existingAmount', formatter: 'sharedFormatter.formatAmount' }"
                                                />
                                                <HBox id="idDupActionHBox">
                                                    <Button
                                                        id="idSkipDupButton"
                                                        text="{i18n>skip}"
                                                        type="Transparent"
                                                        press=".onButtonSkipDuplicatePress"
                                                    />
                                                    <Button
                                                        id="idImportAnywayDupButton"
                                                        text="{i18n>importAnyway}"
                                                        type="Transparent"
                                                        press=".onButtonImportDuplicatePress"
                                                    />
                                                    <ObjectStatus
                                                        id="idDecisionDupObjectStatus"
                                                        text="{ui>decision}"
                                                        class="sapUiTinyMarginBegin"
                                                    />
                                                </HBox>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </IconTabFilter>

                            <IconTabFilter
                                id="idExcludedIconTabFilter"
                                key="excluded"
                                text="{i18n>tabExcluded}"
                                count="{ui>/excludedCount}"
                            >
                                <Table
                                    id="idExcludedRowsTable"
                                    items="{ui>/excludedRows}"
                                >
                                    <columns>
                                        <Column
                                            id="idExRowColumn"
                                            width="5rem"
                                        >
                                            <Text
                                                id="idRowExHeaderText"
                                                text="{i18n>colRow}"
                                            />
                                        </Column>
                                        <Column
                                            id="idExFieldColumn"
                                            width="8rem"
                                        >
                                            <Text
                                                id="idFieldExHeaderText"
                                                text="{i18n>colField}"
                                            />
                                        </Column>
                                        <Column id="idExRawColumn">
                                            <Text
                                                id="idRawCellsExHeaderText"
                                                text="{i18n>colRawCells}"
                                            />
                                        </Column>
                                        <Column
                                            id="idExValueColumn"
                                            width="12rem"
                                        >
                                            <Text
                                                id="idCorrectedValueExHeaderText"
                                                text="{i18n>colCorrectedValue}"
                                            />
                                        </Column>
                                        <Column
                                            id="idExActionColumn"
                                            width="10rem"
                                        >
                                            <Text
                                                id="idActionsExHeaderText"
                                                text="{i18n>colActions}"
                                            />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem id="idExColumnListItem">
                                            <cells>
                                                <Text
                                                    id="idRowNumberExText"
                                                    text="{ui>rowNumber}"
                                                />
                                                <ObjectStatus
                                                    id="idErrorFieldExObjectStatus"
                                                    text="{ui>errorField}"
                                                    state="Error"
                                                />
                                                <Text
                                                    id="idRawJoinedExText"
                                                    text="{ui>rawJoined}"
                                                />
                                                <Input
                                                    id="idEditedValueExInput"
                                                    value="{ui>editedValue}"
                                                />
                                                <Button
                                                    id="idMoveToNewExButton"
                                                    text="{i18n>moveToNew}"
                                                    type="Transparent"
                                                    press=".onButtonMoveToNewPress"
                                                />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </IconTabFilter>
                        </items>
                    </IconTabBar>
                </WizardStep>

                <WizardStep
                    id="idConfirmWizardStep"
                    title="{i18n>step3Title}"
                    icon="sap-icon://accept"
                >
                    <l:Grid
                        id="idConfirmGrid"
                        defaultSpan="XL4 L4 M6 S12"
                    >
                        <VBox
                            id="idConfirmNewVBox"
                            class="sapUiSmallMargin"
                        >
                            <Label
                                id="idToImportConfirmLabel"
                                text="{i18n>confirmToImport}"
                            />
                            <ObjectNumber
                                id="idClearedCountConfirmObjectNumber"
                                number="{ui>/clearedCount}"
                            />
                        </VBox>
                        <VBox
                            id="idConfirmSkippedVBox"
                            class="sapUiSmallMargin"
                        >
                            <Label
                                id="idSkippedPendingConfirmLabel"
                                text="{i18n>confirmSkipped}"
                            />
                            <ObjectNumber
                                id="idSkippedCountConfirmObjectNumber"
                                number="{ui>/skippedCount}"
                            />
                        </VBox>
                        <VBox
                            id="idConfirmExcludedVBox"
                            class="sapUiSmallMargin"
                        >
                            <Label
                                id="idExcludedConfirmLabel"
                                text="{i18n>confirmExcluded}"
                            />
                            <ObjectNumber
                                id="idExcludedCountConfirmObjectNumber"
                                number="{ui>/excludedCount}"
                            />
                        </VBox>
                    </l:Grid>

                    <Button
                        id="idSaveImportButton"
                        text="{i18n>saveImport}"
                        type="Emphasized"
                        icon="sap-icon://save"
                        enabled="{= !${ui>/saving} }"
                        press=".onButtonSaveImportPress"
                        class="sapUiSmallMargin"
                    />

                    <MessageStrip
                        id="idSummaryMessageStrip"
                        text="{ parts: [ 'i18n>summaryImported', 'ui>/summary/transactionCount', { path: 'ui>/summary/totalAmount', formatter: 'sharedFormatter.formatAmount' }, { path: 'ui>/summary/topVendorName', formatter: 'formatter.formatVendorName' } ], formatter: 'formatMessage' }"
                        type="Success"
                        showIcon="true"
                        visible="{= !!${ui>/summary} }"
                        class="sapUiSmallMargin"
                    />
                </WizardStep>
            </Wizard>
        </f:content>
    </f:DynamicPage>
</mvc:View>
