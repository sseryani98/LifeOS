<mvc:View
    controllerName="com.financialplanner.csvimportwizard.controller.CsvImportWizard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    displayBlock="true"
    core:require="{ formatter: 'com/financialplanner/csvimportwizard/model/formatter', sharedFormatter: 'com/financialplanner/shared/util/formatter', formatMessage: 'sap/base/strings/formatMessage' }"
>
    <Page
        id="idWizardPage"
        title="{i18n>pageTitle}"
        class="sapUiContentPadding"
    >
        <content>
            <Wizard
                id="idImportWizard"
            >
                <WizardStep
                    id="idUploadWizardStep"
                    title="{i18n>step1Title}"
                    icon="sap-icon://upload-to-cloud"
                    validated="{ui>/parsed}"
                >
                    <VBox
                        id="idDropZoneVBox"
                        class="sapUiMediumMargin sapUiContentPadding"
                        alignItems="Center"
                        justifyContent="Center"
                    >
                        <core:Icon
                            src="sap-icon://document"
                            size="2.5rem"
                            class="sapUiSmallMarginBottom"
                        />
                        <Text
                            id="idDropHintText"
                            text="{i18n>dropHint}"
                            textAlign="Center"
                        />
                        <u:FileUploader
                            id="idCsvFileUploader"
                            fileType="csv"
                            multiple="true"
                            buttonText="{i18n>chooseFiles}"
                            placeholder="{i18n>noFileChosen}"
                            change=".onFileUploaderChange"
                            class="sapUiSmallMarginTop"
                        />
                    </VBox>

                    <l:Grid
                        id="idUploadGrid"
                        defaultSpan="XL6 L6 M12 S12"
                        class="sapUiSmallMarginTop"
                    >
                        <VBox id="idSelectedFilesVBox">
                            <Label
                                id="idSelectedFilesLabel"
                                text="{i18n>selectedFiles}"
                            />
                            <Text
                                id="idSelectedFilesText"
                                text="{ui>/fileNames}"
                            />
                        </VBox>
                        <VBox id="idCardSelectVBox">
                            <Label
                                id="idCardSelectLabel"
                                text="{i18n>selectCard}"
                                required="true"
                            />
                            <ComboBox
                                id="idCardComboBox"
                                selectedKey="{ui>/selectedCard}"
                                placeholder="{i18n>selectCardPlaceholder}"
                                items="{
                                    path: '/CardInstances',
                                    parameters: { $expand: 'marketCard' },
                                    filters: [ { path: 'lifecycleState', operator: 'NE', value1: 'closed' } ]
                                }"
                            >
                                <core:ListItem
                                    key="{ID}"
                                    text="{marketCard/name}"
                                    additionalText="{cardholderName}"
                                />
                            </ComboBox>
                        </VBox>
                    </l:Grid>

                    <Button
                        id="idParseFilesButton"
                        text="{i18n>parseAndReview}"
                        type="Emphasized"
                        icon="sap-icon://begin"
                        enabled="{ui>/canParse}"
                        press=".onButtonParseFilesPress"
                        class="sapUiSmallMarginTop"
                    />
                </WizardStep>

                <WizardStep
                    id="idReviewWizardStep"
                    title="{i18n>step2Title}"
                    icon="sap-icon://inspection"
                >
                    <IconTabBar
                        id="idReviewIconTabBar"
                        expandable="false"
                        selectedKey="new"
                    >
                        <items>
                            <IconTabFilter
                                id="idNewIconTabFilter"
                                key="new"
                                text="{i18n>tabNew}"
                                count="{ui>/newCount}"
                            >
                                <OverflowToolbar id="idNewOverflowToolbar">
                                    <Text
                                        id="idProgressText"
                                        text="{ parts: [ 'i18n>progressCleared', 'ui>/clearedCount', 'ui>/newCount' ], formatter: 'formatMessage' }"
                                    />
                                    <ProgressIndicator
                                        id="idClearedProgressIndicator"
                                        percentValue="{ui>/progressPercent}"
                                        showValue="false"
                                        width="10rem"
                                        state="Success"
                                    />
                                    <ToolbarSpacer id="idNewToolbarSpacer" />
                                    <Text
                                        id="idRunningTotalText"
                                        text="{ parts: [ 'i18n>runningTotal', { path: 'ui>/totalAmount', formatter: 'sharedFormatter.formatAmount' } ], formatter: 'formatMessage' }"
                                    />
                                    <Button
                                        id="idApplySelectedButton"
                                        text="{i18n>applySelected}"
                                        icon="sap-icon://multiselect-all"
                                        press=".onButtonApplySelectedPress"
                                    />
                                    <Button
                                        id="idNewVendorButton"
                                        text="{i18n>newVendor}"
                                        icon="sap-icon://add"
                                        press=".onButtonNewVendorPress"
                                    />
                                    <Button
                                        id="idNewEarningCategoryButton"
                                        text="{i18n>newEarningCategory}"
                                        icon="sap-icon://add"
                                        press=".onButtonNewEarningCategoryPress"
                                    />
                                </OverflowToolbar>

                                <Table
                                    id="idNewTable"
                                    mode="MultiSelect"
                                    items="{ui>/newRows}"
                                    growing="true"
                                    growingThreshold="50"
                                >
                                    <columns>
                                        <Column
                                            id="idNewDateColumn"
                                            width="8rem"
                                        >
                                            <Text
                                                id="idNewDateHeaderText"
                                                text="{i18n>colDate}"
                                            />
                                        </Column>
                                        <Column id="idNewDescColumn">
                                            <Text
                                                id="idNewDescHeaderText"
                                                text="{i18n>colDescription}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewAmountColumn"
                                            width="7rem"
                                            hAlign="End"
                                        >
                                            <Text
                                                id="idNewAmountHeaderText"
                                                text="{i18n>colAmount}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewVendorColumn"
                                            width="11rem"
                                        >
                                            <Text
                                                id="idNewVendorHeaderText"
                                                text="{i18n>colVendor}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewTypeColumn"
                                            width="11rem"
                                        >
                                            <Text
                                                id="idNewTypeHeaderText"
                                                text="{i18n>colPurchaseType}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewEarnColumn"
                                            width="11rem"
                                        >
                                            <Text
                                                id="idNewEarnHeaderText"
                                                text="{i18n>colEarningCategory}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewYieldColumn"
                                            width="7rem"
                                            hAlign="End"
                                        >
                                            <Text
                                                id="idNewYieldHeaderText"
                                                text="{i18n>colEarningYield}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewCardColumn"
                                            width="11rem"
                                            visible="{ui>/hasSuppCards}"
                                        >
                                            <Text
                                                id="idNewCardHeaderText"
                                                text="{i18n>colCard}"
                                            />
                                        </Column>
                                        <Column
                                            id="idNewActionColumn"
                                            width="13rem"
                                        >
                                            <Text
                                                id="idNewActionHeaderText"
                                                text="{i18n>colActions}"
                                            />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem
                                            id="idNewColumnListItem"
                                        >
                                            <cells>
                                                <Input
                                                    id="idRowDateInput"
                                                    value="{ui>postedAt}"
                                                    editable="{= !${ui>cleared} }"
                                                />
                                                <Input
                                                    id="idRowDescInput"
                                                    value="{ui>rawDescription}"
                                                    editable="{= !${ui>cleared} }"
                                                />
                                                <Input
                                                    id="idRowAmountInput"
                                                    value="{ui>amount}"
                                                    textAlign="End"
                                                    editable="{= !${ui>cleared} }"
                                                />
                                                <ComboBox
                                                    id="idRowVendorComboBox"
                                                    selectedKey="{ui>vendor_ID}"
                                                    enabled="{= !${ui>cleared} }"
                                                    items="{ path: '/Vendors', templateShareable: false }"
                                                >
                                                    <core:Item
                                                        id="idRowVendorItem"
                                                        key="{ID}"
                                                        text="{name}"
                                                    />
                                                </ComboBox>
                                                <ComboBox
                                                    id="idRowTypeComboBox"
                                                    selectedKey="{ui>purchaseType_ID}"
                                                    enabled="{= !${ui>cleared} }"
                                                    items="{ path: '/PurchaseTypes', templateShareable: false }"
                                                >
                                                    <core:Item
                                                        id="idRowTypeItem"
                                                        key="{ID}"
                                                        text="{name}"
                                                    />
                                                </ComboBox>
                                                <ComboBox
                                                    id="idRowEarnComboBox"
                                                    selectedKey="{ui>earningCategory_ID}"
                                                    enabled="{= !${ui>cleared} }"
                                                    items="{ path: '/EarningCategories', templateShareable: false }"
                                                >
                                                    <core:Item
                                                        id="idRowEarnItem"
                                                        key="{ID}"
                                                        text="{name}"
                                                    />
                                                </ComboBox>
                                                <Text
                                                    id="idRowYieldText"
                                                    text="{i18n>yieldDeferred}"
                                                />
                                                <ComboBox
                                                    id="idRowCardComboBox"
                                                    selectedKey="{ui>cardInstance_ID}"
                                                    enabled="{= !${ui>cleared} }"
                                                    visible="{ui>/hasSuppCards}"
                                                    items="{ path: '/CardInstances', parameters: { $expand: 'marketCard' }, templateShareable: false }"
                                                >
                                                    <core:ListItem
                                                        id="idRowCardListItem"
                                                        key="{ID}"
                                                        text="{marketCard/name}"
                                                        additionalText="{cardholderName}"
                                                    />
                                                </ComboBox>
                                                <HBox id="idRowActionHBox">
                                                    <Button
                                                        id="idRowClearButton"
                                                        text="{i18n>clear}"
                                                        type="Transparent"
                                                        press=".onButtonClearRowPress"
                                                        visible="{= !${ui>cleared} }"
                                                    />
                                                    <Button
                                                        id="idRowClearMatchingButton"
                                                        icon="sap-icon://multi-select"
                                                        tooltip="{i18n>clearMatching}"
                                                        type="Transparent"
                                                        press=".onButtonClearMatchingPress"
                                                        visible="{= !${ui>cleared} }"
                                                    />
                                                    <Button
                                                        id="idRowUndoButton"
                                                        text="{i18n>undo}"
                                                        type="Transparent"
                                                        press=".onButtonUndoRowPress"
                                                        visible="{ui>cleared}"
                                                    />
                                                </HBox>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </IconTabFilter>

                            <IconTabFilter
                                id="idDuplicatesIconTabFilter"
                                key="duplicates"
                                text="{i18n>tabDuplicates}"
                                count="{ui>/duplicateCount}"
                            >
                                <Table
                                    id="idDuplicatesTable"
                                    items="{ui>/duplicateRows}"
                                >
                                    <columns>
                                        <Column id="idDupCsvDateColumn">
                                            <Text
                                                id="idDupCsvDateHeaderText"
                                                text="{i18n>colCsvDate}"
                                            />
                                        </Column>
                                        <Column id="idDupCsvDescColumn">
                                            <Text
                                                id="idDupCsvDescHeaderText"
                                                text="{i18n>colCsvDescription}"
                                            />
                                        </Column>
                                        <Column
                                            id="idDupCsvAmountColumn"
                                            hAlign="End"
                                        >
                                            <Text
                                                id="idDupCsvAmountHeaderText"
                                                text="{i18n>colCsvAmount}"
                                            />
                                        </Column>
                                        <Column id="idDupExDateColumn">
                                            <Text
                                                id="idDupExDateHeaderText"
                                                text="{i18n>colExistingDate}"
                                            />
                                        </Column>
                                        <Column id="idDupExDescColumn">
                                            <Text
                                                id="idDupExDescHeaderText"
                                                text="{i18n>colExistingDescription}"
                                            />
                                        </Column>
                                        <Column
                                            id="idDupExAmountColumn"
                                            hAlign="End"
                                        >
                                            <Text
                                                id="idDupExAmountHeaderText"
                                                text="{i18n>colExistingAmount}"
                                            />
                                        </Column>
                                        <Column
                                            id="idDupDecisionColumn"
                                            width="14rem"
                                        >
                                            <Text
                                                id="idDupDecisionHeaderText"
                                                text="{i18n>colDecision}"
                                            />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem
                                            id="idDupColumnListItem"
                                        >
                                            <cells>
                                                <Text
                                                    id="idDupCsvDateText"
                                                    text="{ui>csv/postedAt}"
                                                />
                                                <Text
                                                    id="idDupCsvDescText"
                                                    text="{ui>csv/rawDescription}"
                                                />
                                                <Text
                                                    id="idDupCsvAmountText"
                                                    text="{ path: 'ui>csv/amount', formatter: 'sharedFormatter.formatAmount' }"
                                                />
                                                <Text
                                                    id="idDupExDateText"
                                                    text="{ui>existingPostedAt}"
                                                />
                                                <Text
                                                    id="idDupExDescText"
                                                    text="{ui>existingDescription}"
                                                />
                                                <Text
                                                    id="idDupExAmountText"
                                                    text="{ path: 'ui>existingAmount', formatter: 'sharedFormatter.formatAmount' }"
                                                />
                                                <HBox id="idDupActionHBox">
                                                    <Button
                                                        id="idDupSkipButton"
                                                        text="{i18n>skip}"
                                                        type="Transparent"
                                                        press=".onButtonSkipDuplicatePress"
                                                    />
                                                    <Button
                                                        id="idDupImportButton"
                                                        text="{i18n>importAnyway}"
                                                        type="Transparent"
                                                        press=".onButtonImportDuplicatePress"
                                                    />
                                                    <ObjectStatus
                                                        id="idDupDecisionObjectStatus"
                                                        text="{ui>decision}"
                                                        class="sapUiTinyMarginBegin"
                                                    />
                                                </HBox>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </IconTabFilter>

                            <IconTabFilter
                                id="idExcludedIconTabFilter"
                                key="excluded"
                                text="{i18n>tabExcluded}"
                                count="{ui>/excludedCount}"
                            >
                                <Table
                                    id="idExcludedTable"
                                    items="{ui>/excludedRows}"
                                >
                                    <columns>
                                        <Column
                                            id="idExRowColumn"
                                            width="5rem"
                                        >
                                            <Text
                                                id="idExRowHeaderText"
                                                text="{i18n>colRow}"
                                            />
                                        </Column>
                                        <Column
                                            id="idExFieldColumn"
                                            width="8rem"
                                        >
                                            <Text
                                                id="idExFieldHeaderText"
                                                text="{i18n>colField}"
                                            />
                                        </Column>
                                        <Column id="idExRawColumn">
                                            <Text
                                                id="idExRawHeaderText"
                                                text="{i18n>colRawCells}"
                                            />
                                        </Column>
                                        <Column
                                            id="idExValueColumn"
                                            width="12rem"
                                        >
                                            <Text
                                                id="idExValueHeaderText"
                                                text="{i18n>colCorrectedValue}"
                                            />
                                        </Column>
                                        <Column
                                            id="idExActionColumn"
                                            width="10rem"
                                        >
                                            <Text
                                                id="idExActionHeaderText"
                                                text="{i18n>colActions}"
                                            />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem id="idExColumnListItem">
                                            <cells>
                                                <Text
                                                    id="idExRowText"
                                                    text="{ui>rowNumber}"
                                                />
                                                <ObjectStatus
                                                    id="idExFieldObjectStatus"
                                                    text="{ui>errorField}"
                                                    state="Error"
                                                />
                                                <Text
                                                    id="idExRawText"
                                                    text="{ui>rawJoined}"
                                                />
                                                <Input
                                                    id="idExValueInput"
                                                    value="{ui>editedValue}"
                                                />
                                                <Button
                                                    id="idExMoveButton"
                                                    text="{i18n>moveToNew}"
                                                    type="Transparent"
                                                    press=".onButtonMoveToNewPress"
                                                />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </IconTabFilter>
                        </items>
                    </IconTabBar>
                </WizardStep>

                <WizardStep
                    id="idConfirmWizardStep"
                    title="{i18n>step3Title}"
                    icon="sap-icon://accept"
                >
                    <l:Grid
                        id="idConfirmGrid"
                        defaultSpan="XL4 L4 M6 S12"
                    >
                        <VBox
                            id="idConfirmNewVBox"
                            class="sapUiSmallMargin"
                        >
                            <Label
                                id="idConfirmNewLabel"
                                text="{i18n>confirmToImport}"
                            />
                            <ObjectNumber
                                id="idConfirmNewObjectNumber"
                                number="{ui>/clearedCount}"
                            />
                        </VBox>
                        <VBox
                            id="idConfirmSkippedVBox"
                            class="sapUiSmallMargin"
                        >
                            <Label
                                id="idConfirmSkippedLabel"
                                text="{i18n>confirmSkipped}"
                            />
                            <ObjectNumber
                                id="idConfirmSkippedObjectNumber"
                                number="{ui>/skippedCount}"
                            />
                        </VBox>
                        <VBox
                            id="idConfirmExcludedVBox"
                            class="sapUiSmallMargin"
                        >
                            <Label
                                id="idConfirmExcludedLabel"
                                text="{i18n>confirmExcluded}"
                            />
                            <ObjectNumber
                                id="idConfirmExcludedObjectNumber"
                                number="{ui>/excludedCount}"
                            />
                        </VBox>
                    </l:Grid>

                    <Button
                        id="idSaveImportButton"
                        text="{i18n>saveImport}"
                        type="Emphasized"
                        icon="sap-icon://save"
                        enabled="{= !${ui>/saving} }"
                        press=".onButtonSaveImportPress"
                        class="sapUiSmallMargin"
                    />

                    <MessageStrip
                        id="idSummaryMessageStrip"
                        text="{ parts: [ 'i18n>summaryImported', 'ui>/summary/transactionCount', { path: 'ui>/summary/totalAmount', formatter: 'sharedFormatter.formatAmount' }, { path: 'ui>/summary/topVendorName', formatter: 'formatter.formatVendorName' } ], formatter: 'formatMessage' }"
                        type="Success"
                        showIcon="true"
                        visible="{= !!${ui>/summary} }"
                        class="sapUiSmallMargin"
                    />
                </WizardStep>
            </Wizard>
        </content>
    </Page>
</mvc:View>
