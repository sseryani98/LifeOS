<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <!-- loadFragment templates this fragment first, and that pass resolves a binding type by module name only, never by a core:require alias. -->
    <Dialog
        id="idSplitDialog"
        contentWidth="24rem"
        title="{i18n>splitDialogTitle}"
    >
        <content>
            <form:SimpleForm editable="true">
                <Label text="{i18n>splitMySharePct}" />
                <Input
                    id="idMySharePctSplitInput"
                    value="{splitModel>/mySharePct}"
                    valueState="{splitModel>/mySharePctState}"
                    valueStateText="{splitModel>/mySharePctStateText}"
                    type="Number"
                    textAlign="End"
                    placeholder="{i18n>splitPctEmptyPlaceholder}"
                    description="{i18n>splitPctUnit}"
                    change=".onInputSplitPercentChange"
                />
                <Label text="{i18n>splitMyShareAmount}" />
                <Input
                    id="idMyShareAmountSplitInput"
                    value="{ path: 'splitModel>/myShareAmount', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2, groupingEnabled: false, emptyString: null } }"
                    valueState="{splitModel>/myShareAmountState}"
                    valueStateText="{splitModel>/myShareAmountStateText}"
                    type="Number"
                    textAlign="End"
                    description="{i18n>splitAmountUnit}"
                    change=".onInputSplitAmountChange"
                />
                <Label text="{i18n>splitDescription}" />
                <Input
                    id="idSplitDescriptionInput"
                    value="{splitModel>/splitDescription}"
                />
                <Label text="{i18n>splitRecurring}" />
                <!-- A CheckBox, not a Switch: FE renders the object page's Recurring only as one. -->
                <CheckBox
                    id="idSplitRecurringCheckBox"
                    selected="{splitModel>/isRecurring}"
                />
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button
                id="idSaveSplitButton"
                text="{i18n>saveSplit}"
                type="Emphasized"
                press=".onButtonSplitConfirmPress"
            />
        </beginButton>
        <endButton>
            <Button
                id="idCancelSplitButton"
                text="{i18n>cancel}"
                press=".onButtonSplitCancelPress"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
