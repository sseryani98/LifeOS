{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "paths": {
      "com/lifeos/projecttracker/projectview/*": [
        "./webapp/*"
      ],
      "com/lifeos/shared/*": [
        "../../../Shared/app/*"
      ]
    },
    "types": [
      "@sapui5/types"
    ]
  },
  "include": [
    "webapp/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
