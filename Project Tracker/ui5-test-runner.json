{
  "url": [
    "http://localhost:4105/project-view/webapp/test/testsuite.qunit.html"
  ],
  "start": "node --import tsx ../node_modules/@sap/cds/bin/serve.js",
  "startTimeout": 60000,
  "env": [
    "PORT=4105",
    "CDS_ENV=journey",
    "CDS_TYPESCRIPT=true",
    "CDS_PLUGIN_UI5_MODULES={\"project-view\":{\"configFile\":\"ui5-test.yaml\"}}"
  ],
  "browser": "$/playwright.js",
  "ci": true,
  "reportDir": "report-ui5",
  "coverage": true,
  "coverageReportDir": "coverage-ui5",
  "coverageTempDir": ".nyc_output-ui5",
  "coverageReporters": [
    "lcov",
    "json-summary",
    "text"
  ],
  "coverageCheckLines": 85,
  "coverageCheckBranches": 80
}
