{
  "name": "lifeos-shared",
  "version": "0.0.1",
  "description": "Life OS shared library — the UI5 helpers every module's apps funnel through",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . &&npm run lint:i18n && npm run lint:annotations && npm run lint:filenames && npm run lint:cds-layout && npm run lint:tracking-ids && npm run lint:default-attrs && npm run lint:test-data && npm run lint:test-structure && npm run lint:test-cql && npm run lint:grouped-constants && npm run lint:frontend-constants && npm run lint:domain-types && npm run lint:comment-length && npm run lint:mapper-methods && npm run lint:ui-helpers && npm run lint:frontend-data-access && npm run lint:frontend-controller-shape && npm run lint:control-ids && npm run lint:event-handlers && npm run lint:handler-event-types && npm run lint:facades && npm run lint:design-counts && npm run lint:doc-claims",
    "lint:i18n": "tsx \"../Standards (Technical + Linting)/scripts/lintI18n.ts\"",
    "lint:annotations": "tsx \"../Standards (Technical + Linting)/scripts/lintAnnotations.ts\"",
    "lint:filenames": "tsx \"../Standards (Technical + Linting)/scripts/lintFilenames.ts\"",
    "lint:cds-layout": "tsx \"../Standards (Technical + Linting)/scripts/lintCdsServiceLayout.ts\"",
    "lint:tracking-ids": "tsx \"../Standards (Technical + Linting)/scripts/lintNoTrackingIds.ts\"",
    "lint:default-attrs": "tsx \"../Standards (Technical + Linting)/scripts/lintNoDefaultAttributes.ts\"",
    "lint:test-data": "tsx \"../Standards (Technical + Linting)/scripts/lintTestData.ts\"",
    "lint:test-structure": "tsx \"../Standards (Technical + Linting)/scripts/lintTestStructure.ts\"",
    "lint:test-cql": "tsx \"../Standards (Technical + Linting)/scripts/lintTestCqlAccess.ts\"",
    "lint:grouped-constants": "tsx \"../Standards (Technical + Linting)/scripts/lintGroupedConstants.ts\"",
    "lint:frontend-constants": "tsx \"../Standards (Technical + Linting)/scripts/lintFrontendConstants.ts\"",
    "lint:domain-types": "tsx \"../Standards (Technical + Linting)/scripts/lintDomainTypes.ts\"",
    "lint:comment-length": "tsx \"../Standards (Technical + Linting)/scripts/lintCommentLength.ts\"",
    "lint:mapper-methods": "tsx \"../Standards (Technical + Linting)/scripts/lintMapperMethods.ts\"",
    "lint:ui-helpers": "tsx \"../Standards (Technical + Linting)/scripts/lintUiHelpers.ts\"",
    "lint:frontend-data-access": "tsx \"../Standards (Technical + Linting)/scripts/lintFrontendDataAccess.ts\"",
    "lint:frontend-controller-shape": "tsx \"../Standards (Technical + Linting)/scripts/lintFrontendControllerShape.ts\"",
    "lint:control-ids": "tsx \"../Standards (Technical + Linting)/scripts/lintControlIds.ts\"",
    "lint:event-handlers": "tsx \"../Standards (Technical + Linting)/scripts/lintEventHandlers.ts\"",
    "lint:handler-event-types": "tsx \"../Standards (Technical + Linting)/scripts/lintHandlerEventTypes.ts\"",
    "lint:facades": "tsx \"../Standards (Technical + Linting)/scripts/lintFacades.ts\"",
    "lint:design-counts": "tsx \"../Standards (Technical + Linting)/scripts/lintDesignCounts.ts\"",
    "lint:doc-claims": "tsx \"../Standards (Technical + Linting)/scripts/lintDocClaims.ts\""
  },
  "devDependencies": {
    "@sapui5/types": "^1.136.16",
    "ui5-tooling-transpile": "3.14.0"
  },
  "nyc": {
    "exclude": [
      "**/test/**"
    ]
  },
  "ui5": {
    "dependencies": [
      "ui5-tooling-transpile"
    ]
  }
}
