{
  "_version": "1.49.0",
  "sap.app": {
    "id": "com.financialplanner.adminmasterdata",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "AdminService": {
        "uri": "/service/adminSvcs/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.16",
      "libs": {
        "sap.m": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "AdminService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.financialplanner.adminmasterdata.i18n.i18n"
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "IssuersList",
          "target": "IssuersList"
        },
        {
          "pattern": "Issuers({key}):?query:",
          "name": "IssuersDetail",
          "target": "IssuersDetail"
        },
        {
          "pattern": "RewardsPrograms:?query:",
          "name": "RewardsProgramsList",
          "target": "RewardsProgramsList"
        },
        {
          "pattern": "RewardsPrograms({key}):?query:",
          "name": "RewardsProgramsDetail",
          "target": "RewardsProgramsDetail"
        },
        {
          "pattern": "PurchaseTypes:?query:",
          "name": "PurchaseTypesList",
          "target": "PurchaseTypesList"
        },
        {
          "pattern": "PurchaseTypes({key}):?query:",
          "name": "PurchaseTypesDetail",
          "target": "PurchaseTypesDetail"
        },
        {
          "pattern": "EarningCategories:?query:",
          "name": "EarningCategoriesList",
          "target": "EarningCategoriesList"
        },
        {
          "pattern": "EarningCategories({key}):?query:",
          "name": "EarningCategoriesDetail",
          "target": "EarningCategoriesDetail"
        },
        {
          "pattern": "IssuerApplicationRules:?query:",
          "name": "IssuerApplicationRulesList",
          "target": "IssuerApplicationRulesList"
        },
        {
          "pattern": "IssuerApplicationRules({key}):?query:",
          "name": "IssuerApplicationRulesDetail",
          "target": "IssuerApplicationRulesDetail"
        },
        {
          "pattern": "CsvFormatConfigs:?query:",
          "name": "CsvFormatConfigsList",
          "target": "CsvFormatConfigsList"
        },
        {
          "pattern": "CsvFormatConfigs({key}):?query:",
          "name": "CsvFormatConfigsDetail",
          "target": "CsvFormatConfigsDetail"
        },
        {
          "pattern": "SystemConfigs:?query:",
          "name": "SystemConfigsList",
          "target": "SystemConfigsList"
        },
        {
          "pattern": "SystemConfigs({key}):?query:",
          "name": "SystemConfigsDetail",
          "target": "SystemConfigsDetail"
        },
        {
          "pattern": "BudgetAllocations:?query:",
          "name": "BudgetAllocationsList",
          "target": "BudgetAllocationsList"
        },
        {
          "pattern": "BudgetAllocations({key}):?query:",
          "name": "BudgetAllocationsDetail",
          "target": "BudgetAllocationsDetail"
        },
        {
          "pattern": "RecurrentExpenses:?query:",
          "name": "RecurrentExpensesList",
          "target": "RecurrentExpensesList"
        },
        {
          "pattern": "RecurrentExpenses({key}):?query:",
          "name": "RecurrentExpensesDetail",
          "target": "RecurrentExpensesDetail"
        }
      ],
      "targets": {
        "IssuersList": {
          "type": "Component",
          "id": "IssuersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Issuers",
              "variantManagement": "None",
              "initialLoad": "Enabled",
              "navigation": {
                "Issuers": {
                  "detail": {
                    "route": "IssuersDetail"
                  }
                }
              }
            }
          }
        },
        "IssuersDetail": {
          "type": "Component",
          "id": "IssuersDetail",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Issuers",
              "editableHeaderContent": true
            }
          }
        },
        "RewardsProgramsList": {
