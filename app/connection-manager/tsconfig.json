{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "paths": {
      "com/financialplanner/connectionmanager/*": ["./webapp/*"],
      "com/financialplanner/shared/*": ["../shared/*"]
    },
    "types": ["@sapui5/types"]
  },
  "include": ["webapp/**/*.ts"],
  "exclude": ["node_modules"]
}
