<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout.form"
>
    <Dialog
        id="idAddConnectionDialog"
        title="{i18n>addDialogTitle}"
        contentWidth="32rem"
    >
        <content>
            <MessageStrip
                text="{i18n>addDialogIntro}"
                showIcon="true"
                class="sapUiSmallMargin"
            />
            <Button
                text="{i18n>openSetupPage}"
                icon="sap-icon://action"
                press=".onButtonOpenSetupPagePress"
                class="sapUiSmallMarginBegin sapUiSmallMarginBottom"
            />
            <l:SimpleForm
                editable="true"
                labelSpanXL="4"
                labelSpanM="4"
            >
                <Label
                    text="{i18n>displayNameLabel}"
                    required="true"
                />
                <Input
                    value="{ui>/displayName}"
                    placeholder="{i18n>displayNamePlaceholder}"
                />
                <Label
                    text="{i18n>setupTokenLabel}"
                    required="true"
                />
                <TextArea
                    value="{ui>/setupToken}"
                    placeholder="{i18n>setupTokenPlaceholder}"
                    rows="4"
                    width="100%"
                />
            </l:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="{i18n>claim}"
                type="Emphasized"
                press=".onButtonClaimTokenPress"
            />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>cancel}"
                press=".onButtonCancelAddConnectionPress"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
