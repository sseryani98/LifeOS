<mvc:View
    controllerName="com.financialplanner.shell.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    displayBlock="true"
>
    <tnt:ToolPage
        id="toolPage"
        sideExpanded="true"
    >
        <!-- Header -->
        <tnt:header>
            <tnt:ToolHeader>
                <Title
                    text="{i18n>appTitle}"
                    level="H4"
                    class="sapUiSmallMarginBegin"
                />
                <ToolbarSpacer />
            </tnt:ToolHeader>
        </tnt:header>

        <!-- Side Navigation — items hidden until built; visible flags toggled per sprint -->
        <tnt:sideContent>
            <tnt:SideNavigation
                id="sideNav"
                itemSelect=".onNavItemSelect"
            >
                <tnt:NavigationList>
                    <!-- Group: Transactions -->
                    <tnt:NavigationListItem
                        text="{i18n>navTransactions}"
                        icon="sap-icon://payment-approval"
                        expanded="false"
                        visible="false"
                    >
                        <tnt:NavigationListItem
                            text="{i18n>navWeeklyReview}"
                            key="WEEKLY_REVIEW"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navTransactionList}"
                            key="TRANSACTION_LIST"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navCsvImport}"
                            key="CSV_IMPORT"
                            visible="false"
                        />
                    </tnt:NavigationListItem>

                    <!-- Group: Churning — Cards -->
                    <tnt:NavigationListItem
                        text="{i18n>navChurningCards}"
                        icon="sap-icon://credit-card"
                        expanded="false"
                        visible="false"
                    >
                        <tnt:NavigationListItem
                            text="{i18n>navMyCards}"
                            key="MY_CARDS"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navMarketCards}"
                            key="MARKET_CARDS"
                            visible="false"
                        />
                    </tnt:NavigationListItem>

                    <!-- Group: Churning — Analytics -->
                    <tnt:NavigationListItem
                        text="{i18n>navChurningAnalytics}"
                        icon="sap-icon://business-objects-experience"
                        expanded="false"
                        visible="false"
                    >
                        <tnt:NavigationListItem
                            text="{i18n>navChurnboard}"
                            key="churnboard"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navTrophyCase}"
                            key="TROPHY_CASE"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navCardAnalytics}"
                            key="CARD_ANALYTICS"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navRecommendationMatrix}"
                            key="RECOMMENDATION_MATRIX"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navPerkTracker}"
                            key="PERK_TRACKER"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navPointsDashboard}"
                            key="POINTS_DASHBOARD"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navAnnualSummary}"
                            key="ANNUAL_SUMMARY"
                            visible="false"
                        />
                    </tnt:NavigationListItem>

                    <!-- Group: Finances -->
                    <tnt:NavigationListItem
                        text="{i18n>navFinances}"
                        icon="sap-icon://wallet"
                        expanded="false"
                        visible="false"
                    >
                        <tnt:NavigationListItem
                            text="{i18n>navBudgetDashboard}"
                            key="BUDGET_DASHBOARD"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navIncomeEntry}"
                            key="INCOME_ENTRY"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navGoals}"
                            key="GOALS"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navGoalProgress}"
                            key="GOAL_PROGRESS"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navSpendingTrends}"
                            key="SPENDING_TRENDS"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navIncomeVsExpenses}"
                            key="INCOME_VS_EXPENSES"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navFinancialPictureEntry}"
                            key="FINANCIAL_PICTURE_ENTRY"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navFinancialPictureDashboard}"
                            key="FINANCIAL_PICTURE_DASHBOARD"
                            visible="false"
                        />
                    </tnt:NavigationListItem>

                    <!-- Group: Admin — Master Data entities (per-entity nav, D-92) -->
                    <tnt:NavigationListItem
                        text="{i18n>navAdmin}"
                        icon="sap-icon://action-settings"
                        expanded="true"
                        visible="true"
                    >
                        <tnt:NavigationListItem
                            text="{i18n>navIssuers}"
                            key="MD_ISSUERS"
                            visible="true"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navRewardsPrograms}"
                            key="MD_REWARDS_PROGRAMS"
                            visible="true"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navPurchaseTypes}"
                            key="MD_PURCHASE_TYPES"
                            visible="true"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navEarningCategories}"
                            key="MD_EARNING_CATEGORIES"
                            visible="true"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navApplicationRules}"
                            key="MD_APP_RULES"
                            visible="true"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navCsvFormats}"
                            key="MD_CSV_CONFIGS"
                            visible="true"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navSystemConfig}"
                            key="MD_SYSTEM_CONFIGS"
                            visible="true"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navBudgetAllocations}"
                            key="MD_BUDGET_ALLOCATIONS"
                            visible="true"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navRecurrentExpenses}"
                            key="MD_RECURRENT_EXPENSES"
                            visible="true"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navSimplefinConnections}"
                            key="SIMPLEFIN_CONNECTIONS"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navScraperApprovals}"
                            key="SCRAPER_APPROVALS"
                            visible="false"
                        />
                    </tnt:NavigationListItem>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <!-- Content Area -->
        <tnt:mainContents>
            <Page
                id="appContent"
                showHeader="false"
            >
                <Text
                    text="{i18n>welcomeText}"
                    class="sapUiMediumMargin"
                />
            </Page>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
