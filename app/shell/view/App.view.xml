<mvc:View
    controllerName="com.financialplanner.shell.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    displayBlock="true"
>
    <tnt:ToolPage id="idToolPage">
        <tnt:header>
            <tnt:ToolHeader>
                <Button
                    id="idNavBackButton"
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    press=".onButtonNavBackPress"
                    visible="{shellView>/backVisible}"
                    tooltip="{i18n>navBack}"
                />
                <core:Icon
                    src="sap-icon://lead"
                    class="sapUiSmallMarginBegin"
                />
                <Title
                    text="{i18n>appTitle}"
                    level="H4"
                    class="sapUiTinyMarginBegin"
                />
                <ToolbarSpacer />
            </tnt:ToolHeader>
        </tnt:header>

        <tnt:sideContent>
            <tnt:SideNavigation
                id="idSideNavigation"
                selectedKey="{shellView>/selectedKey}"
                itemSelect=".onSideNavigationItemSelect"
            >
                <tnt:NavigationList>
                    <tnt:NavigationListItem
                        text="{i18n>navTransactions}"
                        icon="sap-icon://payment-approval"
                        expanded="false"
                    >
                        <tnt:NavigationListItem
                            text="{i18n>navWeeklyReview}"
                            key="WEEKLY_REVIEW"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navTransactionList}"
                            key="TRANSACTION_LIST"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navCsvImport}"
                            key="CSV_IMPORT"
                        />
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem
                        text="{i18n>navChurningCards}"
                        icon="sap-icon://credit-card"
                        expanded="false"
                        visible="false"
                    >
                        <tnt:NavigationListItem
                            text="{i18n>navMyCards}"
                            key="MY_CARDS"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navMarketCards}"
                            key="MARKET_CARDS"
                            visible="false"
                        />
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem
                        text="{i18n>navChurningAnalytics}"
                        icon="sap-icon://business-objects-experience"
                        expanded="false"
                        visible="false"
                    >
                        <tnt:NavigationListItem
                            text="{i18n>navChurnboard}"
                            key="churnboard"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navTrophyCase}"
                            key="TROPHY_CASE"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navCardAnalytics}"
                            key="CARD_ANALYTICS"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navRecommendationMatrix}"
                            key="RECOMMENDATION_MATRIX"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navPerkTracker}"
                            key="PERK_TRACKER"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navPointsDashboard}"
                            key="POINTS_DASHBOARD"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navAnnualSummary}"
                            key="ANNUAL_SUMMARY"
                            visible="false"
                        />
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem
                        text="{i18n>navFinances}"
                        icon="sap-icon://wallet"
                        expanded="false"
                        visible="false"
                    >
                        <tnt:NavigationListItem
                            text="{i18n>navBudgetDashboard}"
                            key="BUDGET_DASHBOARD"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navIncomeEntry}"
                            key="INCOME_ENTRY"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navGoals}"
                            key="GOALS"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navGoalProgress}"
                            key="GOAL_PROGRESS"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navSpendingTrends}"
                            key="SPENDING_TRENDS"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navIncomeVsExpenses}"
                            key="INCOME_VS_EXPENSES"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navFinancialPictureEntry}"
                            key="FINANCIAL_PICTURE_ENTRY"
                            visible="false"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navFinancialPictureDashboard}"
                            key="FINANCIAL_PICTURE_DASHBOARD"
                            visible="false"
                        />
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem
                        text="{i18n>navAdmin}"
                        icon="sap-icon://action-settings"
                    >
                        <tnt:NavigationListItem
                            text="{i18n>navIssuers}"
                            key="MD_ISSUERS"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navRewardsPrograms}"
                            key="MD_REWARDS_PROGRAMS"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navPurchaseCategories}"
                            key="MD_PURCHASE_CATEGORIES"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navEarningCategories}"
                            key="MD_EARNING_CATEGORIES"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navApplicationRules}"
                            key="MD_APP_RULES"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navCsvFormats}"
                            key="MD_CSV_CONFIGS"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navSystemConfig}"
                            key="MD_SYSTEM_CONFIGS"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navBudgetAllocations}"
                            key="MD_BUDGET_ALLOCATIONS"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navRecurrentExpenses}"
                            key="MD_RECURRENT_EXPENSES"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navFinancialAccountTypes}"
                            key="MD_FINANCIAL_ACCOUNT_TYPES"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navIncomeSourceTypes}"
                            key="MD_INCOME_SOURCE_TYPES"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navPerkTypes}"
                            key="MD_PERK_TYPES"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navAdjustmentTypes}"
                            key="MD_ADJUSTMENT_TYPES"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navRedemptionTypes}"
                            key="MD_REDEMPTION_TYPES"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navScrapeMappings}"
                            key="MD_SCRAPE_MAPPINGS"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navSimplefinConnections}"
                            key="SIMPLEFIN_CONNECTIONS"
                        />
                        <tnt:NavigationListItem
                            text="{i18n>navScraperApprovals}"
                            key="SCRAPER_APPROVALS"
                            visible="false"
                        />
                    </tnt:NavigationListItem>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <mvc:XMLView
                viewName="com.financialplanner.shell.view.Welcome"
                visible="{shellView>/welcomeVisible}"
            />
            <Page
                id="idAppContentPage"
                showHeader="false"
                visible="{= !${shellView>/welcomeVisible}}"
            />
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
