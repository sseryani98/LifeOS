{
  "name": "life-os",
  "version": "0.0.1",
  "description": "Personal ERP — a suite of modules sharing one stack, one standard, one lint suite",
  "private": true,
  "type": "module",
  "workspaces": [
    "Financial Planner",
    "Project Tracker",
    "Shared"
  ],
  "scripts": {
    "lint": "npm run lint:harness && npm run lint:standards && npm run lint --workspaces --if-present",
    "lint:standards": "cd \"Standards (Technical + Linting)\" && eslint scripts/",
    "test": "npm run test --workspaces --if-present",
    "lint:comments": "tsx \"Standards (Technical + Linting)/scripts/lintCommentLength.ts\"",
    "lint:harness": "tsx \"Standards (Technical + Linting)/scripts/lintAgentPrompts.ts\""
  },
  "devDependencies": {
    "@sap/cds": "9.8.4",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "eslint_d": "^15.0.3",
    "eslint-plugin-import": "^2",
    "eslint-plugin-jsdoc": "^50",
    "eslint-plugin-unicorn": "^64.0.0",
    "jest": "^29",
    "nyc": "18.0.0",
    "playwright": "1.56.1",
    "ts-jest": "^29",
    "ts-node": "^10",
    "tsx": "^4",
    "typescript": "^5",
    "ui5-test-runner": "5.14.2"
  },
  "ui5": {
    "ui5parser": {
      "proxyWorkspaces": [
        "Financial Planner"
      ]
    }
  }
}
