    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "eslint-plugin-import": "^2",
    "eslint-plugin-jsdoc": "^50",
    "eslint-plugin-unicorn": "^64.0.0",
    "jest": "^29",
    "ts-jest": "^29",
    "ts-node": "^10",
    "tsx": "^4",
    "typescript": "^5"
  }
}
