{
  "name": "life-os",
  "version": "0.0.1",
  "description": "Personal ERP — a suite of modules sharing one stack, one standard, one lint suite",
  "private": true,
  "type": "module",
  "workspaces": [
    "Financial Planner"
  ],
  "scripts": {
    "lint": "npm run lint:standards && npm run lint --workspaces --if-present",
